{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vela",
  "version": "0.5.0",
  "identifier": "dev.vela.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vela",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "dmg"],
    "category": "Productivity",
    "shortDescription": "Visor local de PDF y Markdown",
    "longDescription": "Vela es un visor de documentos PDF y Markdown rápido, sobrio y completamente local: sin cuentas, sin nube y sin analítica.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF",
        "description": "Documento PDF",
        "role": "Editor",
        "rank": "Default"
      },
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "Markdown",
        "description": "Documento Markdown",
        "role": "Editor",
        "rank": "Default"
      }
    ]
  }
}
